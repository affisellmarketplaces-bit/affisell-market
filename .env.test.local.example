# Copy to .env.test.local (git-ignored). Used ONLY by `npm run test:db`.
# Create a Neon BRANCH of your database (Neon console -> Branches -> Create branch) and paste ITS connection string.
# The test harness refuses any URL pointing at the same endpoint as DATABASE_URL / DIRECT_URL / DATABASE_URL_STAGING
# found in .env, .env.local, etc. Never put the production URL here.
DATABASE_URL_TEST=""
# Optional (defaults to DATABASE_URL_TEST). Use the branch's non-pooled URL if you run migrations.
DIRECT_URL_TEST=""
# Set to 1 ONLY if DATABASE_URL_TEST is your Neon "staging" branch (also listed as DATABASE_URL_STAGING in .env.local).
# Production URLs are always refused, whatever this flag says.
# DB_TEST_ALLOW_STAGING=1
