{
  "installCommand": "npm ci --no-audit --no-fund",
  "buildCommand": "node scripts/vercel-build.mjs",
  "build": {
    "env": {
      "BUILD_RUN_MIGRATIONS": "1"
    }
  },
  "crons": [
    {
      "path": "/api/cron/migrate",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/sync-autods",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/try-on-retention",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/reconcile",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/onboarding",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/ing-manual-nudge",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/legal-guardian",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/radar/cron/global-scan",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/radar/cron/alerts",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/radar-scan",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/radar-rotate",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron/tiktok-refresh",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/aliexpress/refresh",
      "schedule": "0 */12 * * *"
    },
    {
      "path": "/api/cron/tiktok-sync-orders",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/tiktok-sync-full",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/margin-locks",
      "schedule": "15 5 * * *"
    },
    {
      "path": "/api/cron/stock-check",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/boost-expire",
      "schedule": "*/1 * * * *"
    },
    {
      "path": "/api/pulse/battle/create",
      "schedule": "0 16 * * *"
    }
  ]
}
