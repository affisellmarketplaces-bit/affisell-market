# Medusa backend (optional — Virtual Try-On extension)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/medusa"
# Affisell Prisma catalog used by the try-on sync — a LOCAL or staging database.
# Production is refused by the scripts unless AFFISELL_ALLOW_PRODUCTION_WRITES names its endpoint.
DATABASE_URL_PRISMA=""
# Default supplier User.id for auto-created Prisma products from Medusa Admin
MEDUSA_PRISMA_SYNC_SUPPLIER_ID=""
# Stripe (Medusa payment-stripe provider)
STRIPE_API_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
REDIS_URL="redis://localhost:6379"
STORE_CORS="http://localhost:3001,http://localhost:3002"
ADMIN_CORS="http://localhost:9000,http://localhost:7001"
AUTH_CORS="http://localhost:9000,http://localhost:7001"
# Required, random, >= 32 characters: openssl rand -hex 32 (Medusa refuses to start otherwise)
JWT_SECRET=""
COOKIE_SECRET=""
# Admin account created by `npm run user:create` / `npm run setup:auto` (never commit real values)
MEDUSA_ADMIN_EMAIL=""
MEDUSA_ADMIN_PASSWORD=""
