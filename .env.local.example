# Local overrides — copy to `.env.local` (gitignored). Takes precedence over `.env`.
# Dev server: `npm run dev` → http://localhost:${PORT} (default PORT=3001 via scripts/next-dev-port.mjs).
#
# NEVER copy these localhost URLs to Vercel Production / Preview.
# Prod: NEXT_PUBLIC_APP_URL=https://affisell.com · NEXTAUTH_URL=https://affisell.com
# Code: @/lib/site-url (getSiteUrl) — rejects localhost on production deploys.

# ── Port sync (keep all three aligned — run npm run verify:wizard-v2:dev) ──
PORT=3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3001

# Optional — cron/API scripts fallback when APP_URL unset
# APP_URL=http://localhost:3001

# ── Wizard v2 local dev ──
# Default off in prod; enable locally to skip ?wizard=v2 query param
ENABLE_WIZARD_V2=1

# Affisell InstantScan — RETIRED from wizard UI (Express + Pro only).
# Keep ENABLE_INSTANTSCAN=0|unset. Opt-in only for dormant API diagnostics.
# ENABLE_INSTANTSCAN=0
# NEXT_PUBLIC_ENABLE_INSTANTSCAN=0
# ENABLE_AI_VISION_V2=1
# NEXT_PUBLIC_ENABLE_AI_VISION_V2=1
OPENAI_API_KEY=""
PRODUCT_VISION_V2_MODEL=gpt-4o
AI_VISION_V2_CONFIDENCE_THRESHOLD=0.4
# Local Redis (optional — prod uses UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN)
# REDIS_URL=redis://localhost:6379
# GROQ_API_KEY=""   # text + vision (qwen/qwen3.6-27b)

# PostHog wizard_v2_* events (optional)
# NEXT_PUBLIC_POSTHOG_KEY=""

# Feature flags (staging first — docs/ENVIRONMENTS.md)
# NEXT_PUBLIC_FF_NEW_RADAR="1"
# NEXT_PUBLIC_FF_LUXE="1"
# NEXT_PUBLIC_FF_HUMANOID_SHIELD_DASHBOARD="1"
# NEXT_PUBLIC_FF_WIZARD_V2="1"
# NEXT_PUBLIC_FF_INSTANTSCAN="1"

# Cloudinary (optional legacy CDN — prefer R2 / Vercel Blob / S3)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# Database (local Docker: npm run db:local:setup)
# DATABASE_URL="postgresql://affisell:affisell@localhost:5433/affisell"

# ── Affisell Radar (schema Postgres `market_intelli`) ──
# Si vide / localhost:5434, `npm run radar:db:push` utilise DATABASE_URL (Neon).
# Même instance Neon que Affisell — tables isolées dans le schema market_intelli.
RADAR_DATABASE_URL=
# RADAR_ENABLED=false
# RADAR_BETA_USER_IDS=

# Auth secrets — generate: openssl rand -base64 32
# NEXTAUTH_SECRET=""

# ── Shell-safe URLs (zsh glob on unquoted ?wizard=v2) ──
# Bad:  curl http://localhost:3001/dashboard/supplier/products/new?wizard=v2
# Good: curl "http://localhost:3001/dashboard/supplier/products/new?wizard=v2"
# Good: npm run dev:open:wizard-v2
# Good: npm run verify:wizard-v2:dev   → prints JSON-quoted URL
# Good: npm run test:wizard:v2         → unit tests + env preflight

# ── Dev perf (optional) ──
# Faster first compile (can hang on some routes): AFFISELL_DEV_TURBOPACK=1
# Neon pooler in dev — fewer cold connects, slightly higher query latency:
# PRISMA_USE_POOLER_DEV=1
